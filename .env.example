# web-dhcp: все настройки. Скопируйте в .env (он в .gitignore) и поправьте под себя: cp .env.example .env
# start.sh берёт отсюда значения по умолчанию (.env, а если его нет - .env.example); на вопросы можно жать Enter
# или запустить с -y. Итог start.sh записывает в <INSTALL_DIR>/.env - его читают служба, хук dnsmasq и чистка.
# Пустое значение = «не задано»: start.sh возьмёт своё по умолчанию (часто - определит сам: интерфейс, подсеть...).
# Формат: КЛЮЧ=значение, без кавычек; # - комментарий. Переменные окружения с теми же именами важнее файла.

# ---------------------------------------------------------------- установка (читает только start.sh)
# куда ставить программу (там же venv и рабочий .env)
INSTALL_DIR=/opt/web-dhcp
# имя службы systemd (и префикс таймера чистки, конфигов dnsmasq)
INSTALL_SERVICE=web-dhcp
# поднять свой DHCP-сервер (dnsmasq) на DASH_IFACE: y / n (если dnsmasq уже раздаёт адреса - только хук)
INSTALL_DHCP=y
# адрес сервера на DASH_IFACE в CIDR - нужен, только если у интерфейса нет IPv4 (start.sh назначит постоянно)
INSTALL_DHCP_ADDR=
# диапазон выдаваемых адресов (пусто - .100-.250 подсети интерфейса)
INSTALL_DHCP_START=
INSTALL_DHCP_END=
# время аренды
INSTALL_DHCP_LEASE=12h
# шлюз и DNS-серверы (через запятую) для клиентов; пусто - не выдавать
INSTALL_DHCP_GATEWAY=
INSTALL_DHCP_DNS=
# отдавать PXE-клиентам опцию 60 «PXEClient» (для proxyDHCP, например iVentoy): y / n
INSTALL_DHCP_PXE=n

# ---------------------------------------------------------------- программа
# интерфейс DHCP-сети: по его ARP-таблице - «в сети» (пусто - start.sh предложит; в программе пусто = все интерфейсы)
DASH_IFACE=
# порт и адрес веб-панели
DASH_PORT=8080
DASH_BIND=0.0.0.0
# файл аренд dnsmasq
DASH_LEASES=/var/lib/misc/dnsmasq.leases
# история клиентов (vendor class, когда впервые/последний раз) - пишет хук dnsmasq
DASH_HOSTS_DIR=/var/lib/web-dhcp/hosts
# заголовок страницы (пусто - «Сеть <подсеть интерфейса>»)
DASH_TITLE=
# адрес сервера для шапки (пусто - start.sh подставит адрес основного интерфейса)
DASH_SERVER_ADDR=
# ссылка «IPMI сервера» в шапке (пусто - нет)
DASH_IPMI_URL=
# порт iVentoy на этом сервере - блок статуса iVentoy (пусто - нет; start.sh подставит 26000, если iVentoy найден)
DASH_IVENTOY_PORT=
# ссылка «Общая папка»; {host} - адрес, по которому открыта страница (пусто - нет; start.sh подставит, если занят 8081)
DASH_SHARE_URL=
# путь Samba-шары для показа рядом со ссылкой (пусто - нет)
DASH_SMB_PATH=
# через сколько часов вне сети забывать клиента (0 - никогда)
DASH_PRUNE_HOURS=24
# как часто опрашивать IPMI (UDP 623), секунд
DASH_PROBE_INTERVAL=60

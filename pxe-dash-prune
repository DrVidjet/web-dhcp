#!/usr/bin/env python3
"""pxe-dash-prune: забыть клиентов DHCP-сети, которых не было в сети дольше DASH_PRUNE_HOURS (24 ч).

Запускается таймером <служба>-prune.timer (ставит start.sh). Отмечает last_online для клиентов из ARP-таблицы
интерфейса DASH_IFACE; перед тем как забыть клиента, пингует его ещё раз (тихая, но живая машина останется).
Использование: pxe-dash-prune [--dry-run]
"""
import json
import os
import subprocess
import sys
import time

def load_conf():
    """.env (KEY=VALUE, # - комментарий) рядом со скриптом (старое имя - config.env);
    переменные окружения DASH_* важнее. Пустое значение = не задано."""
    conf = {}
    here = os.path.dirname(os.path.realpath(__file__))
    for path in ([os.environ["DASH_CONF"]] if os.environ.get("DASH_CONF") else
                 [os.path.join(here, ".env"), os.path.join(here, "config.env")]):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        if v.strip():
                            conf[k.strip()] = v.strip()
            break
        except OSError:
            continue
    conf.update((k, v) for k, v in os.environ.items() if k.startswith("DASH_"))
    return conf


C = load_conf()
HOSTS_DIR = C.get("DASH_HOSTS_DIR", "/var/lib/web-dhcp/hosts")
IFACE = C.get("DASH_IFACE", "")
ARP_FILE = C.get("DASH_ARP_FILE", "/proc/net/arp")
MAX_AGE = int(float(C.get("DASH_PRUNE_HOURS", "24")) * 3600)


def online_macs():
    macs = set()
    try:
        with open(ARP_FILE) as f:
            next(f)
            for line in f:
                p = line.split()
                if len(p) >= 6 and (not IFACE or p[5] == IFACE) and p[2] == "0x2":
                    macs.add(p[3].lower())
    except OSError:
        pass
    return macs


def ping(ip):
    subprocess.run(["ping", "-c1", "-W1"] + (["-I", IFACE] if IFACE else []) + [ip],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def save(path, host):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(host, f)
    os.replace(tmp, path)


def main():
    dry = "--dry-run" in sys.argv
    now = int(time.time())
    try:
        names = sorted(os.listdir(HOSTS_DIR))
    except FileNotFoundError:
        return 0
    seen = online_macs()
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(HOSTS_DIR, name)
        try:
            with open(path) as f:
                host = json.load(f)
            mac = host["mac"].lower()
        except (OSError, ValueError, KeyError):
            continue
        last = max(host.get(k, 0) for k in ("last_online", "last_seen", "first_seen"))
        if mac not in seen and now - last > MAX_AGE and host.get("ip"):
            ping(host["ip"])
            seen = online_macs()
        if mac in seen:
            if not dry:
                host["last_online"] = now
                save(path, host)
        elif now - last > MAX_AGE:
            print("%s %s %s last active %s" % ("would forget" if dry else "forgot", mac, host.get("ip", ""),
                                               time.strftime("%F %T", time.localtime(last))))
            if not dry:
                os.remove(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
